{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tkaudioservices.github.io/digico-knowledge/libraries/schema/library.schema.json",
  "title": "DiGiCo Knowledge library",
  "type": "object",
  "required": ["id", "kind", "title", "source", "extracted", "items"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "kind": { "enum": ["macros", "fader-banks", "channel-template", "snapshot-template", "naming", "patch", "other"] },
    "title": { "type": "string", "minLength": 1 },
    "console": { "type": "string" },
    "version": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "extracted": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "notes": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    }
  },
  "additionalProperties": true
}
